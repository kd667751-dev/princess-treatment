# Turso Database Configuration (libSQL)
# 1. Sign up at https://turso.tech or run: `turso auth signup` / `turso auth login`
# 2. Create your database: `turso db create princess-db`
# 3. Get your database URL: `turso db show princess-db --url`
# 4. Generate an auth token: `turso db tokens create princess-db`

TURSO_DATABASE_URL="libsql://princess-db-[your-username].turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"
